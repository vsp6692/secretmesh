#!/bin/sh
# Pre-push: the slow checks. Runs the entire Go suite, including the AWS
# integration tests, on LocalStack and on Moto, with the race detector and no
# skipped tests. Needs Docker (about 40 seconds).
set -eu
cd "$(git rev-parse --show-toplevel)"
. .githooks/lib.sh
failed=0

zero=0000000000000000000000000000000000000000
changed=
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then range="origin/main..$local_sha"; else range="$remote_sha..$local_sha"; fi
  changed="$changed
$(git diff --name-only "$range" 2>/dev/null || git ls-files)"
done
[ -n "$(printf '%s' "$changed" | tr -d '[:space:]')" ] || exit 0

if ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker is not running. The integration tests need it (LocalStack, Moto, Postgres)." >&2
  echo "Start Docker, or bypass once with 'git push --no-verify' (CI will still run them)." >&2
  exit 1
fi

compose="docker compose -f deployments/docker/compose.test.yaml"
started_here=0
if [ -z "$($compose ps -q 2>/dev/null)" ]; then started_here=1; fi
cleanup() { [ "$started_here" = 1 ] && [ -z "${SM_KEEP_STACK:-}" ] && $compose down -v >/dev/null 2>&1 || true; }
trap cleanup EXIT

step "test stack is up (Postgres, LocalStack, Moto)" $compose up -d --wait
step "integration suite on LocalStack" make --no-print-directory test-localstack
step "integration suite on Moto" make --no-print-directory test-moto
if printf '%s\n' "$changed" | grep -q '^apps/web/'; then
  step "web: production build" sh -c 'cd apps/web && NEXT_TELEMETRY_DISABLED=1 npm run build'
fi

finish "Push"
