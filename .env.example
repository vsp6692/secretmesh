# Local development settings, matching deployments/docker/compose.yaml.
# `make dev` copies this to .env on first run. Never commit .env.

SECRETMESH_HTTP_ADDR=127.0.0.1:8080
SECRETMESH_PUBLIC_URL=http://localhost:3000
SECRETMESH_LOG_LEVEL=debug

# Runtime role: DML only, no BYPASSRLS.
SECRETMESH_DATABASE_URL=postgres://secretmesh_app:secretmesh_app_dev@localhost:5433/secretmesh?sslmode=disable
# Schema owner, used only by `secretmesh-api migrate`.
SECRETMESH_MIGRATIONS_DATABASE_URL=postgres://secretmesh_migrator:secretmesh_migrator_dev@localhost:5433/secretmesh?sslmode=disable

SECRETMESH_OIDC_ISSUER=http://localhost:8081/realms/secretmesh
SECRETMESH_OIDC_CLIENT_ID=secretmesh
SECRETMESH_OIDC_CLIENT_SECRET=secretmesh-dev-client-secret
# ID token "amr" / "acr" values that count as multi-factor (see docs/guides/oidc.md).
#SECRETMESH_OIDC_MFA_AMR=mfa,otp,hwk
#SECRETMESH_OIDC_MFA_ACR=
# Only for single-tenant IdPs that omit email_verified (e.g. Entra ID).
#SECRETMESH_OIDC_ASSUME_EMAIL_VERIFIED=false

# Browsers accept non-Secure cookies on http://localhost only.
SECRETMESH_COOKIE_SECURE=false
SECRETMESH_SESSION_TTL=12h

SECRETMESH_BOOTSTRAP_ORG_SLUG=acme
SECRETMESH_BOOTSTRAP_ORG_NAME=Acme Technologies
SECRETMESH_BOOTSTRAP_ADMIN_EMAIL=admin@secretmesh.local

# Approvals, execution and audit (ADR-0009).
# 32 random bytes, base64 (openssl rand -base64 32). Derives approval MAC keys
# and the audit signing key. This value is for local development only.
SECRETMESH_MASTER_KEY=/WwvtCL+1sW1zNJRl1IwySlwU+m3zGbNz5H/Q2Sl+lo=
# In-memory provider for development; never enable in production.
SECRETMESH_ENABLE_FAKE_CONNECTOR=true
# embedded: run background jobs in the API process; off: run `secretmesh-api worker`.
SECRETMESH_WORKER=embedded

# AWS (ADR-0010). SecretMesh uses the default AWS credential chain for its own
# identity and assumes each connection's role. Locally, every AWS client points
# at Moto (`make deps-up`); never set the endpoint override in production.
SECRETMESH_ENABLE_AWS_CONNECTOR=true
SECRETMESH_AWS_ENDPOINT_URL=http://127.0.0.1:5050
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
# Azure Key Vault and Google Cloud Secret Manager (ADR-0012). Both are off by
# default because they authenticate with the workload identity of the
# deployment (Azure workload identity / managed identity; GCP Application
# Default Credentials). Never put credentials in connection settings.
# SECRETMESH_ENABLE_AZURE_CONNECTOR=true
# SECRETMESH_ENABLE_GCP_CONNECTOR=true
# Emulator endpoints only; never set in production.
# SECRETMESH_AZURE_ENDPOINT_URL=
# SECRETMESH_GCP_ENDPOINT_URL=
# SECRETMESH_GCP_IAM_ENDPOINT_URL=
# Development only: accept a service account key file as SecretMesh's own GCP identity.
# SECRETMESH_GCP_ALLOW_SERVICE_ACCOUNT_KEYS=false
# Keyring: local (derived from SECRETMESH_MASTER_KEY) or aws-kms.
# SECRETMESH_KEYRING=aws-kms
# SECRETMESH_KMS_MAC_KEY_ID=alias/secretmesh-mac
# SECRETMESH_KMS_SIGNING_KEY_ID=alias/secretmesh-audit-signing
# Audit export to an S3 bucket with Object Lock (disabled when unset).
# SECRETMESH_AUDIT_EXPORT_BUCKET=
# SECRETMESH_AUDIT_EXPORT_REGION=
# SECRETMESH_AUDIT_EXPORT_RETENTION_DAYS=365

# Notifications (ADR-0011). Locally, email goes to Mailpit (http://localhost:8025).
SECRETMESH_SMTP_ADDR=127.0.0.1:1025
SECRETMESH_SMTP_FROM=SecretMesh <secretmesh@secretmesh.local>
SECRETMESH_SMTP_TLS=none
# SECRETMESH_SMTP_USERNAME=
# SECRETMESH_SMTP_PASSWORD=
# Slack channels may only post to webhooks under these prefixes.
# SECRETMESH_SLACK_WEBHOOK_PREFIXES=https://hooks.slack.com/
# SECRETMESH_ROTATION_VERIFY_TIMEOUT=30m

# Used by `next dev` / `next build` for the /api and /auth rewrites.
SECRETMESH_API_URL=http://127.0.0.1:8080

# Integration tests create throwaway databases here.
SECRETMESH_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable
# AWS integration tests run against Moto here.
SECRETMESH_TEST_AWS_ENDPOINT=http://127.0.0.1:5050
